// 3D version of FluidSim2D.compute, following Sebastian Lague's FluidSim.compute (3D kernels + 27-cell spatial hash).
#pragma kernel ExternalForces
#pragma kernel UpdateSpatialHash
#pragma kernel CountKeys
#pragma kernel ScanOffsets
#pragma kernel ScatterEntries
#pragma kernel Reorder
#pragma kernel CopyBack
#pragma kernel CalculateDensities
#pragma kernel CalculatePressureForce
#pragma kernel CalculateViscosity
#pragma kernel UpdatePositions
#pragma kernel UpdateColors

static const int NumThreads = 64;
static const float PI = 3.14159265;

RWStructuredBuffer<float4> Positions;          // xyz used; float4 so Sphere.shader reads it directly
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float2> Densities;          // x = density, y = near density
RWStructuredBuffer<uint3>  SpatialIndices;     // (particle index, cell hash, key) sorted by key
RWStructuredBuffer<uint3>  UnsortedEntries;    // same, in particle order, before the count sort
RWStructuredBuffer<float4> SortTarget_Positions;          // scratch for Reorder
RWStructuredBuffer<float3> SortTarget_PredictedPositions;
RWStructuredBuffer<float3> SortTarget_Velocities;
RWStructuredBuffer<uint>   SpatialOffsets;
RWStructuredBuffer<float4> Colors;
StructuredBuffer<float4>   SpeedGradient;

uint   numParticles;
float  deltaTime;
float  gravity;
float  collisionDamping;
float  smoothingRadius;
float  targetDensity;
float  pressureMultiplier;
float  nearPressureMultiplier;
float  viscosityStrength;
float  maxSpeed;
float3 boundsSize;
float4x4 localToWorld;   // the GpuSphere transform: move/rotate it in the Scene view to tilt the box
float4x4 worldToLocal;

// ---- Spatial hash 3D (Lague) ----
static const int3 offsets3D[27] =
{
    int3(-1, -1, -1), int3(0, -1, -1), int3(1, -1, -1), int3(-1, 0, -1), int3(0, 0, -1), int3(1, 0, -1), int3(-1, 1, -1), int3(0, 1, -1), int3(1, 1, -1),
    int3(-1, -1,  0), int3(0, -1,  0), int3(1, -1,  0), int3(-1, 0,  0), int3(0, 0,  0), int3(1, 0,  0), int3(-1, 1,  0), int3(0, 1,  0), int3(1, 1,  0),
    int3(-1, -1,  1), int3(0, -1,  1), int3(1, -1,  1), int3(-1, 0,  1), int3(0, 0,  1), int3(1, 0,  1), int3(-1, 1,  1), int3(0, 1,  1), int3(1, 1,  1)
};
static const uint hashK1 = 15823;
static const uint hashK2 = 9737333;
static const uint hashK3 = 440817757;

int3 GetCell3D(float3 position, float radius) { return (int3)floor(position / radius); }
uint HashCell3D(int3 cell)
{
    const uint blockSize = 50;
    uint3 ucell = (uint3)(cell + blockSize / 2);
    uint3 localCell = ucell % blockSize;
    uint3 blockID = ucell / blockSize;
    uint blockHash = blockID.x * hashK1 + blockID.y * hashK2 + blockID.z * hashK3;
    return localCell.x + blockSize * (localCell.y + blockSize * localCell.z) + blockHash;
}
uint KeyFromHash(uint hash, uint tableSize) { return hash % tableSize; }

// ---- 3D kernels (Lague's FluidMaths3D normalisations) ----
float DensityKernel(float dst, float radius)         { if (dst >= radius) return 0; float v = radius - dst; return v * v * 15 / (2 * PI * pow(abs(radius), 5)); }
float DensityDerivative(float dst, float radius)     { if (dst >= radius) return 0; return (radius - dst) * 15 / (PI * pow(abs(radius), 5)); }
float NearDensityKernel(float dst, float radius)     { if (dst >= radius) return 0; float v = radius - dst; return v * v * v * 15 / (PI * pow(abs(radius), 6)); }
float NearDensityDerivative(float dst, float radius) { if (dst >= radius) return 0; float v = radius - dst; return v * v * 45 / (PI * pow(abs(radius), 6)); }
float ViscosityKernel(float dst, float radius)       { if (dst >= radius) return 0; float v = radius * radius - dst * dst; return v * v * v * 315 / (64 * PI * pow(abs(radius), 9)); }

float PressureFromDensity(float density)         { return pressureMultiplier * (density - targetDensity); }
float NearPressureFromDensity(float nearDensity) { return nearPressureMultiplier * nearDensity; }

[numthreads(NumThreads, 1, 1)]
void ExternalForces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    Velocities[id.x] += float3(0, -gravity, 0) * deltaTime;
    PredictedPositions[id.x] = Positions[id.x].xyz + Velocities[id.x] * (1 / 120.0);
}

[numthreads(NumThreads, 1, 1)]
void UpdateSpatialHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    SpatialOffsets[id.x] = 0; // key counts, filled by CountKeys
    uint hash = HashCell3D(GetCell3D(PredictedPositions[id.x], smoothingRadius));
    UnsortedEntries[id.x] = uint3(id.x, hash, KeyFromHash(hash, numParticles));
}

// ---- Count sort by key (Lague's GPUCountSort): count -> inclusive scan -> scatter with atomic decrement.
// After ScatterEntries, SpatialOffsets[key] holds the first index of that key's run in SpatialIndices.
[numthreads(NumThreads, 1, 1)]
void CountKeys(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    InterlockedAdd(SpatialOffsets[UnsortedEntries[id.x].z], 1);
}

// Inclusive prefix sum over all numParticles counts in a single thread group: each thread scans a contiguous chunk,
// the chunk totals are scanned in shared memory, then each chunk is offset. Two passes over memory, no recursion.
static const uint ScanThreads = 1024;
groupshared uint chunkSums[ScanThreads];

[numthreads(1024, 1, 1)]
void ScanOffsets(uint3 gid : SV_GroupThreadID)
{
    uint t = gid.x;
    uint chunk = (numParticles + ScanThreads - 1) / ScanThreads;
    uint first = t * chunk;
    uint last  = min(first + chunk, numParticles);

    uint sum = 0;
    for (uint i = first; i < last; i++) { sum += SpatialOffsets[i]; SpatialOffsets[i] = sum; }
    chunkSums[t] = sum;
    GroupMemoryBarrierWithGroupSync();

    for (uint offset = 1; offset < ScanThreads; offset <<= 1)
    {
        uint v = t >= offset ? chunkSums[t - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        chunkSums[t] += v;
        GroupMemoryBarrierWithGroupSync();
    }

    uint add = chunkSums[t] - sum; // exclusive prefix of this chunk
    for (uint j = first; j < last; j++) SpatialOffsets[j] += add;
}

[numthreads(NumThreads, 1, 1)]
void ScatterEntries(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint3 entry = UnsortedEntries[id.x];
    uint end;
    InterlockedAdd(SpatialOffsets[entry.z], 0xFFFFFFFFu, end); // decrement; returns the value before
    SpatialIndices[end - 1] = entry;
}

// Lague's Reorder/CopyBack: physically sort the particle arrays into key order so that particle i IS sorted entry i.
// Neighbour loops then read consecutive memory instead of chasing SpatialIndices[].x.
[numthreads(NumThreads, 1, 1)]
void Reorder(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint src = SpatialIndices[id.x].x;
    SortTarget_Positions[id.x]          = Positions[src];
    SortTarget_PredictedPositions[id.x] = PredictedPositions[src];
    SortTarget_Velocities[id.x]         = Velocities[src];
}

[numthreads(NumThreads, 1, 1)]
void CopyBack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    Positions[id.x]          = SortTarget_Positions[id.x];
    PredictedPositions[id.x] = SortTarget_PredictedPositions[id.x];
    Velocities[id.x]         = SortTarget_Velocities[id.x];
}

#define FOR_EACH_NEIGHBOUR(pos, BODY)                                                         \
{                                                                                             \
    int3 originCell = GetCell3D(pos, smoothingRadius);                                        \
    float sqrRadius = smoothingRadius * smoothingRadius;                                      \
    for (int c = 0; c < 27; c++)                                                              \
    {                                                                                         \
        uint hash = HashCell3D(originCell + offsets3D[c]);                                    \
        uint key  = KeyFromHash(hash, numParticles);                                          \
        uint currIndex = SpatialOffsets[key];                                                 \
        while (currIndex < numParticles)                                                      \
        {                                                                                     \
            uint3 indexData = SpatialIndices[currIndex];                                      \
            uint neighbourIndex = currIndex;    /* arrays are reordered to sorted order */     \
            currIndex++;                                                                      \
            if (indexData.z != key) break;                                                    \
            if (indexData.y != hash) continue;                                                \
            float3 offsetToNeighbour = PredictedPositions[neighbourIndex] - pos;              \
            float sqrDst = dot(offsetToNeighbour, offsetToNeighbour);                         \
            if (sqrDst > sqrRadius) continue;                                                 \
            float dst = sqrt(sqrDst);                                                         \
            BODY                                                                              \
        }                                                                                     \
    }                                                                                         \
}

[numthreads(NumThreads, 1, 1)]
void CalculateDensities(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    float3 pos = PredictedPositions[id.x];
    float density = 0, nearDensity = 0;
    FOR_EACH_NEIGHBOUR(pos,
        density     += DensityKernel(dst, smoothingRadius);
        nearDensity += NearDensityKernel(dst, smoothingRadius);
    )
    Densities[id.x] = float2(density, nearDensity);
}

[numthreads(NumThreads, 1, 1)]
void CalculatePressureForce(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    float3 pos = PredictedPositions[id.x];
    float density      = Densities[id.x].x;
    float nearDensity  = Densities[id.x].y;
    float pressure     = PressureFromDensity(density);
    float nearPressure = NearPressureFromDensity(nearDensity);
    float3 pressureForce = 0;

    FOR_EACH_NEIGHBOUR(pos,
        if (neighbourIndex == id.x) continue;
        float3 dirToNeighbour = dst > 0 ? offsetToNeighbour / dst : float3(0, 1, 0);
        float neighbourDensity     = Densities[neighbourIndex].x;
        float neighbourNearDensity = Densities[neighbourIndex].y;
        float sharedPressure     = (pressure + PressureFromDensity(neighbourDensity)) * 0.5;
        float sharedNearPressure = (nearPressure + NearPressureFromDensity(neighbourNearDensity)) * 0.5;
        pressureForce -= dirToNeighbour * DensityDerivative(dst, smoothingRadius) * sharedPressure / neighbourDensity;
        pressureForce -= dirToNeighbour * NearDensityDerivative(dst, smoothingRadius) * sharedNearPressure / neighbourNearDensity;
    )

    Velocities[id.x] += pressureForce / density * deltaTime;
}

[numthreads(NumThreads, 1, 1)]
void CalculateViscosity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    float3 pos = PredictedPositions[id.x];
    float3 velocity = Velocities[id.x];
    float3 viscosityForce = 0;
    FOR_EACH_NEIGHBOUR(pos,
        if (neighbourIndex == id.x) continue;
        viscosityForce += (Velocities[neighbourIndex] - velocity) * ViscosityKernel(dst, smoothingRadius);
    )
    Velocities[id.x] += viscosityForce * viscosityStrength * deltaTime;
}

[numthreads(NumThreads, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    float3 vel = Velocities[id.x];
    float3 pos = Positions[id.x].xyz + vel * deltaTime;

    // Collide in the box's local space so the box can be moved and rotated (Lague's ResolveCollisions)
    float3 posLocal = mul(worldToLocal, float4(pos, 1)).xyz;
    float3 velLocal = mul(worldToLocal, float4(vel, 0)).xyz;
    float3 halfSize = boundsSize * 0.5;
    if (abs(posLocal.x) > halfSize.x) { posLocal.x = halfSize.x * sign(posLocal.x); velLocal.x *= -collisionDamping; }
    if (abs(posLocal.y) > halfSize.y) { posLocal.y = halfSize.y * sign(posLocal.y); velLocal.y *= -collisionDamping; }
    if (abs(posLocal.z) > halfSize.z) { posLocal.z = halfSize.z * sign(posLocal.z); velLocal.z *= -collisionDamping; }
    pos = mul(localToWorld, float4(posLocal, 1)).xyz;
    vel = mul(localToWorld, float4(velLocal, 0)).xyz;

    Positions[id.x]  = float4(pos, 0);
    Velocities[id.x] = vel;
}

[numthreads(NumThreads, 1, 1)]
void UpdateColors(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    float t = saturate(length(Velocities[id.x]) / maxSpeed);
    Colors[id.x] = SpeedGradient[(uint)(t * 63)];
}
